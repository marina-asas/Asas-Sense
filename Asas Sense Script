local Hitbox = {}
Hitbox.Enabled = false; Hitbox.Size = 5; Hitbox.SKIP_TEAM = true
Hitbox._originals = {}; Hitbox._conn = nil
local function isTeamExcluded(plr)
    if plr == LocalPlayer then return true end
    if not Hitbox.SKIP_TEAM then return false end
    if LocalPlayer.Team and plr.Team then return LocalPlayer.Team == plr.Team end
    return false
end
local function applyHitbox(model, size)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            local n = part.Name
            if n == "HumanoidRootPart" or n == "Torso" or n == "UpperTorso" or n == "LowerTorso" or n == "Hitbox" or n == "RootPart" then
                if not Hitbox._originals[part] then Hitbox._originals[part] = { size = part.Size, massless = part.Massless, trans = part.Transparency } end
                local o = Hitbox._originals[part].size
                part.Size = Vector3.new(math.max(o.X, size), math.max(o.Y, size), math.max(o.Z, size))
                part.Massless = true; part.CanCollide = false; part.Transparency = 0.7
            end
        end
    end
end
local function restoreHitbox(model)
    for _, part in ipairs(model:GetDescendants()) do
        local o = Hitbox._originals[part]
        if o then part.Size = o.size; part.Massless = o.massless; part.Transparency = o.trans; part.CanCollide = true; Hitbox._originals[part] = nil end
    end
end
function Hitbox.SetSize(n) Hitbox.Size = math.clamp(n, 2, 30) end
function Hitbox.Set(state)
    if Hitbox.Enabled == state then return end
    Hitbox.Enabled = state
    if state then
        Hitbox._conn = RunService.Heartbeat:Connect(function()
            if not Hitbox.Enabled then return end
            for _, plr in ipairs(Players:GetPlayers()) do
                local char = plr.Character
                if isTeamExcluded(plr) or Whitelist.Has(plr) then if char then restoreHitbox(char) end
                elseif char and char:FindFirstChildOfClass("Humanoid") then applyHitbox(char, Hitbox.Size) end
            end
        end)
    else
        if Hitbox._conn then Hitbox._conn:Disconnect(); Hitbox._conn = nil end
        for _, plr in ipairs(Players:GetPlayers()) do if plr.Character then restoreHitbox(plr.Character) end end
    end
end

