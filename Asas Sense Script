    visSec:CreateToggle({Id = "AsasCrosshair", Name = "Asas Crosshair", State = false, Callback = function(state) Visuals.SetCrosshair(state) end})
    
    skySec:CreateToggle({Id = "SkyColor", Name = "Sky Color", State = false, Callback = function(state) Visuals.SetSkyColor(state, Visuals.SkyColor) end})
    skySec:CreateButton({Name = "Random Sky Color", Callback = function()
        Visuals.SkyColor = Color3.fromRGB(math.random(0,255), math.random(0,255), math.random(0,255))
        if Visuals.SkyEnabled then Visuals.SetSkyColor(true, Visuals.SkyColor) end
    end})
    
    skySec:CreateToggle({Id = "Rain", Name = "Rain", State = false, Callback = function(state) Visuals.SetRain(state) end})
    skySec:CreateToggle({Id = "Snow", Name = "Snow", State = false, Callback = function(state) Visuals.SetSnow(state) end})

    -- Misc Tab
    local miscSec = miscTab:CreateSection({Name = "Misc", Size = 310, Side = "Left"})
    miscSec:CreateToggle({Id = "Fullbright", Name = "Fullbright", State = false, Callback = function(state) Misc.SetFullbright(state) end})
    miscSec:CreateToggle({Id = "AntiAFK", Name = "Anti-AFK", State = false, Callback = function(state) Misc.SetAntiAFK(state) end})
    miscSec:CreateToggle({Id = "FPSUnlock", Name = "FPS Unlock", State = false, Callback = function(state) Misc.SetFPSUnlock(state) end})
    miscSec:CreateToggle({Id = "Watermark", Name = "Watermark", State = false, Callback = function(state) SetWatermark(state) end})
    
    miscSec:CreateToggle({Id = "Autoload", Name = "Autoload Config", State = AutoloadEnabled, Callback = function(state)
        AutoloadEnabled = state
        SaveConfig()
        print("[asas] Autoload set to: " .. tostring(state))
    end})

    miscSec:CreateToggle({Id = "RivalsSkinChanger", Name = "Rivals Skin Changer", State = false, Callback = function(state)
        Misc.SetRivalsSkinChanger(state)
    end})

    miscSec:CreateKeybind({
        Id = "ScriptShowKeybind",
        Name = "Script Show Keybind",
        State = { "KeyCode", "Z" },
        Mode = "BindOnly",
        ListenAllKeys = true,
        Callback = function(bind)
            if type(bind) == "table" and bind[1] and bind[2] then
                window.ShowKey = { bind[1], bind[2] }
            else
                window.ShowKey = nil
            end
        end
    })

    miscSec:CreateKeybind({
        Id = "CloseScriptKeybind",
        Name = "Close Script Keybind",
        State = { "KeyCode", "X" },
        Mode = "BindOnly",
        ListenAllKeys = true,
        Callback = function(bind)
            if type(bind) == "table" and bind[1] and bind[2] then
                window.CloseKey = { bind[1], bind[2] }
            else
                window.CloseKey = nil
            end
        end
    })

    -- Scripts Section (Misc Tab)
    local scriptSec = miscTab:CreateSection({Name = "Scripts", Size = 325, Side = "Right"})
    
    local scriptOptions = {}
    for i, v in ipairs(ExternalScripts) do table.insert(scriptOptions, v.Name) end
    
    local selectedScripts = {}
    scriptSec:CreateMultibox({Id = "ScriptsList", Name = "Select Script", State = {}, Options = scriptOptions, Callback = function(selectedIndices)
        selectedScripts = selectedIndices
    end})
    
    scriptSec:CreateButton({Name = "EXECUTE", Callback = function()
        for _, idx in ipairs(selectedScripts) do
            local scriptData = ExternalScripts[idx]
            if scriptData then
                print("[asas] Executing: " .. scriptData.Name)
                local ok, err = pcall(scriptData.Source)
                if not ok then warn("[asas] " .. scriptData.Name .. " failed: " .. tostring(err)) end
            end
        end
    end})

    local setOptions = {}
    for _, s in ipairs(ScriptSets) do table.insert(setOptions, s.Name) end
    local selectedSetIndex = 1

    scriptSec:CreateDropdown({Id = "ScriptSetSelect", Name = "Select Set", State = 1, Options = setOptions, Callback = function(opt)
        for idx, s in ipairs(ScriptSets) do
            if s.Name == opt then
                selectedSetIndex = idx
                break
            end
        end
    end})

    scriptSec:CreateButton({Name = "SET EXECUTE", Callback = function()
        local setData = ScriptSets[selectedSetIndex]
        if not setData then return end
        print("[asas] Executing Set: " .. setData.Name)
        for _, entry in ipairs(setData.Scripts) do
            task.spawn(function()
                runRemoteScript(entry.Name, entry.Url)
            end)
        end
    end})
end)
