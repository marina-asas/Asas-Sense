local function runRemoteScript(label, url)
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if not ok or type(body) ~= "string" or #body == 0 or body:find("404: Not Found") then
        warn("[asas] " .. label .. ": fetch failed")
        return
    end
    local chunk, compileErr = loadstring(body)
    if not chunk then
        warn("[asas] " .. label .. ": compile failed — " .. tostring(compileErr))
        return
    end
    local ran, err = pcall(chunk)
    if not ran then
        warn("[asas] " .. label .. ": runtime error — " .. tostring(err))
    else
        print("[asas] " .. label .. ": loaded")
    end
end

