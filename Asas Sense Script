        end

        function sections:CreateKeybind(Properties)
            Properties = Properties or {}
            local Content = {
                Name = Properties.Name or "New Keybind",
                State = Properties.State or nil,
                Mode = Properties.Mode or "Hold",
                Callback = Properties.Callback or function() end,
                Active = false,
                Holding = false,
                Window = self.Window,
                Page = self.Page,
                Section = self,
                Id = Properties.Id or Properties.Name,
                ListenAllKeys = Properties.ListenAllKeys or false,
            }
            if AutoloadEnabled and Content.Id and ConfigData[Content.Id] and type(ConfigData[Content.Id].State) == "table" then
                Content.State = ConfigData[Content.Id].State
            end
            local Keys = {
                KeyCodes = {"Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P", "A", "S", "D", "F", "G", "H", "J", "K", "L", "Z", "X", "C", "V", "B", "N", "M", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Seveen", "Eight", "Nine", "Zero", "0", "Insert", "Delete", "Tab", "Home", "End", "LeftAlt", "LeftControl", "LeftShift", "RightAlt", "RightControl", "RightShift", "CapsLock", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12"},
                Inputs = {"MouseButton1", "MouseButton2", "MouseButton3"},
                Shortened = {["MouseButton1"] = "M1", ["MouseButton2"] = "M2", ["MouseButton3"] = "M3", ["Insert"] = "INS", ["Delete"] = "DEL", ["LeftAlt"] = "LA", ["LeftControl"] = "LC", ["LeftShift"] = "LS", ["RightAlt"] = "RA", ["RightControl"] = "RC", ["RightShift"] = "RS", ["CapsLock"] = "CL"}
            }
            do
                local Content_Holder = utility:RenderObject("Frame", {BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Content.Section.Holder, Size = UDim2.new(1, 0, 0, 18), ZIndex = 3})
                utility:RenderObject("TextLabel", {BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Content_Holder, Position = UDim2.new(0, 41, 0, 0), Size = UDim2.new(1, -41, 1, 0), ZIndex = 3, Font = "Code", Text = Content.Name, TextColor3 = Color3.fromRGB(205, 205, 205), TextSize = 9, TextXAlignment = "Left"})
                local Content_Holder_Button = utility:RenderObject("TextButton", {BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Content_Holder, Size = UDim2.new(1, 0, 1, 0), Text = ""})
                local Content_Holder_Value = utility:RenderObject("TextLabel", {BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Content_Holder, Position = UDim2.new(0, 41, 0, 0), Size = UDim2.new(1, -61, 1, 0), ZIndex = 3, Font = "Code", Text = "", TextColor3 = Color3.fromRGB(114, 114, 114), TextSize = 9, TextXAlignment = "Right"})
                function Content:Set(state, isLoad)
                    Content.State = (type(state) == "table") and state or {}
                    Content.Active = false
                    local label = (#Content:Get() >= 2) and Content:Shorten(Content:Get()[2]) or "-"
                    Content_Holder_Value.Text = "[" .. label .. "]"
                    if Content.Mode == "BindOnly" then
                        Content.Callback(Content:Get())
                    elseif not isLoad then
                        Content.Callback(Content.Active)
                    end
                    if not isLoad and AutoloadEnabled and Content.Id then ConfigData[Content.Id] = ConfigData[Content.Id] or {}; ConfigData[Content.Id].State = Content.State; SaveConfig() end
                end
                function Content:Get() return Content.State end
                function Content:Shorten(Str) for i, v in pairs(Keys.Shortened) do Str = string.gsub(Str, i, v) end return Str end
                function Content:Change(Key)
                    if Key and Key.EnumType then
                        if Key.EnumType == Enum.KeyCode or Key.EnumType == Enum.UserInputType then
                            if Content.ListenAllKeys or table.find(Keys.KeyCodes, Key.Name) or table.find(Keys.Inputs, Key.Name) then
                                Content:Set({Key.EnumType == Enum.KeyCode and "KeyCode" or "UserInputType", Key.Name})
                                return true
                            end
                        end
                    end
                    return false
                end
                utility:CreateConnection(Content_Holder_Button.MouseButton1Click, function()
                    Content.Holding = true
                    Content_Holder_Value.TextColor3 = Color3.fromRGB(255, 0, 0)
                end)
                utility:CreateConnection(Content_Holder_Button.MouseButton2Click, function()
                    Content.Holding = false
                    Content_Holder_Value.TextColor3 = Color3.fromRGB(114, 114, 114)
                    Content:Set({})
                end)
                utility:CreateConnection(Content_Holder_Button.MouseEnter, function() Content_Holder_Value.TextColor3 = Color3.fromRGB(164, 164, 164) end)
                utility:CreateConnection(Content_Holder_Button.MouseLeave, function() Content_Holder_Value.TextColor3 = Content.Holding and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(114, 114, 114) end)
                utility:CreateConnection(uis.InputBegan, function(Input)
                    if Content.Holding then
                        if Input.KeyCode == Enum.KeyCode.Escape then
                            Content.Holding = false
                            Content_Holder_Value.TextColor3 = Color3.fromRGB(114, 114, 114)
                            Content:Set({})
                            return
                        end
                        local Success = Content:Change(Input.KeyCode.Name ~= "Unknown" and Input.KeyCode or Input.UserInputType)
                        if Success then
                            Content.Holding = false
                            Content_Holder_Value.TextColor3 = Color3.fromRGB(114, 114, 114)
                        end
                        return
                    end
                    if uis:GetFocusedTextBox() then return end
                    local cur = Content:Get()
                    if cur[1] and cur[2] then
                        local enumGroup = Enum[cur[1]]
                        local targetEnum = enumGroup and enumGroup[cur[2]]
                        if targetEnum and ((cur[1] == "KeyCode" and Input.KeyCode == targetEnum) or (cur[1] == "UserInputType" and Input.UserInputType == targetEnum)) then
                            if Content.Mode == "Hold" then
                                Content.Active = true
                                Content.Callback(Content.Active)
                            elseif Content.Mode == "Toggle" then
                                Content.Active = not Content.Active
                                Content.Callback(Content.Active)
                            elseif Content.Mode == "Action" then
                                Content.Callback(true)
                            end
                        end
                    end
                end)
                utility:CreateConnection(uis.InputEnded, function(Input)
                    if Content.Mode ~= "Hold" then return end
                    local cur = Content:Get()
                    if cur[1] and cur[2] then
                        local enumGroup = Enum[cur[1]]
                        local targetEnum = enumGroup and enumGroup[cur[2]]
                        if targetEnum and ((cur[1] == "KeyCode" and Input.KeyCode == targetEnum) or (cur[1] == "UserInputType" and Input.UserInputType == targetEnum)) then
                            Content.Active = false
                            Content.Callback(Content.Active)
                        end
                    end
                end)
                Content:Set(Content.State, true)
            end
            return Content
        end

