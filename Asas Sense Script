        if Aim._triggerTask then task.cancel(Aim._triggerTask); Aim._triggerTask = nil end
    end
end

-- ========== TELEPORT ==========
local Teleport = {}
function Teleport.GetTargets()
    local list = {}
    local myChar = LocalPlayer.Character
    local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position or Vector3.zero
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart"); local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then table.insert(list, { player = plr, distance = (hrp.Position - myPos).Magnitude }) end
        end
    end
    table.sort(list, function(a, b) return a.distance < b.distance end)
    return list
end
function Teleport.GoTo(plr)
    if not plr or plr == LocalPlayer then return false end
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart"); if not myHRP then return false end
    local targetHRP = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart"); if not targetHRP then return false end
    myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
    return true
end

