                        else obj.Head.Visible = false end
                        if ESP.Settings.Skeleton then
                            local rigType = hum.RigType == Enum.HumanoidRigType.R15 and "R15" or "R6"
                            local mapping = Bones[rigType]
                            for i, bonePair in ipairs(mapping) do
                                local part1 = p.Character:FindFirstChild(bonePair[1]); local part2 = p.Character:FindFirstChild(bonePair[2]); local line = obj.Skeleton[i]
                                if part1 and part2 and line then
                                    local sp1, os1 = Camera:WorldToViewportPoint(part1.Position); local sp2, os2 = Camera:WorldToViewportPoint(part2.Position)
                                    if os1 and os2 then line.From = Vector2.new(sp1.X, sp1.Y); line.To = Vector2.new(sp2.X, sp2.Y); line.Visible = true else line.Visible = false end
                                elseif line then line.Visible = false end
                            end
                        else for _, line in pairs(obj.Skeleton) do line.Visible = false end end
                    else
                        obj.Box.Visible = false; obj.Name.Visible = false; obj.Health.Visible = false; obj.Dist.Visible = false; obj.Head.Visible = false
                        for _, line in pairs(obj.Skeleton) do line.Visible = false end
                    end
                else
                    obj.Box.Visible = false; obj.Name.Visible = false; obj.Health.Visible = false; obj.Dist.Visible = false; obj.Head.Visible = false
                    for _, line in pairs(obj.Skeleton) do line.Visible = false end
                end
            else
                obj.Box.Visible = false; obj.Name.Visible = false; obj.Health.Visible = false; obj.Dist.Visible = false; obj.Head.Visible = false
                for _, line in pairs(obj.Skeleton) do line.Visible = false end
            end
        end
    end)
    ESP.Connection = { PlayerAdded, PlayerRemoving, Render }
end
function ESP.Stop()
    if not ESP.Enabled then return end
    ESP.Enabled = false
    for p, obj in pairs(ESP.Objects) do
        if obj.Box then obj.Box:Remove() end; if obj.Name then obj.Name:Remove() end; if obj.Health then obj.Health:Remove() end
        if obj.Dist then obj.Dist:Remove() end; if obj.Head then obj.Head:Remove() end
        if obj.Skeleton then for _, line in pairs(obj.Skeleton) do line:Remove() end end
    end
    ESP.Objects = {}
    if ESP.Connection then for _, conn in ipairs(ESP.Connection) do conn:Disconnect() end; ESP.Connection = nil end
end
function ESP.Set(state) if state then ESP.Start() else ESP.Stop() end end

