local CROSSHAIR_CFG = {
    WatermarkText = "Asas.Win",
    Length = 17,
    Thick = 1,
    Gap = 10,
    RotSpd = 150,
    PulseSpd = 3.5,
    SizeRng = 5,
    RGBSpeed = 0.12,

    GlowRadius = 6,
    GlowStrength = 0.45,
    GlowLayers = 24,

    TextGlowRadius = 3,
    TextGlowStrength = 0.25,
    TextGlowLayers = 6,

    TextColor = Color3.fromRGB(255, 255, 255),
    LineColor = Color3.fromRGB(255, 255, 255),
    LineOutlineThick = 1,
}

local function smoothstepCrosshair(x)
    x = math.clamp(x, 0, 1)
    return x * x * (3 - 2 * x)
end

local function clearCrosshair()
    if Visuals.Connections.CrosshairInput then
        Visuals.Connections.CrosshairInput:Disconnect()
        Visuals.Connections.CrosshairInput = nil
    end
    if Visuals.Connections.CrosshairRender then
        Visuals.Connections.CrosshairRender:Disconnect()
        Visuals.Connections.CrosshairRender = nil
    end
    if Visuals.Objects.CrosshairGui and Visuals.Objects.CrosshairGui.Parent then
        Visuals.Objects.CrosshairGui:Destroy()
    end
    Visuals.Objects.CrosshairGui = nil
    local targetGui = CoreGui or LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if targetGui and targetGui:FindFirstChild("SleepyStaticCenterCrosshair") then
        targetGui.SleepyStaticCenterCrosshair:Destroy()
    end
end

function Visuals.SetCrosshair(state)
    if Visuals.CrosshairEnabled == state then return end
    Visuals.CrosshairEnabled = state
    clearCrosshair()
    if not state then return end

    local targetGui = CoreGui or LocalPlayer:WaitForChild("PlayerGui", 5)
    if not targetGui then return end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SleepyStaticCenterCrosshair"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 9999
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = targetGui
    Visuals.Objects.CrosshairGui = screenGui

    local centerContainer = Instance.new("Frame")
    centerContainer.Name = "Centro"
    centerContainer.Size = UDim2.fromOffset(0, 0)
    centerContainer.Position = UDim2.fromScale(0.5, 0.5)
    centerContainer.BackgroundTransparency = 1
    centerContainer.Parent = screenGui

    local cfg = CROSSHAIR_CFG
    local n = cfg.GlowLayers
    local glowR = cfg.GlowRadius
    local outPad = 1
    local perpBase = cfg.Thick + 2 * outPad
    local h = 2 * math.ceil(cfg.Gap + cfg.Length + cfg.SizeRng + glowR + outPad + 2)

    local glowSpace = Instance.new("Frame")
    glowSpace.Name = "GlowSpace"
    glowSpace.AnchorPoint = Vector2.new(0.5, 0.5)
    glowSpace.Position = UDim2.fromOffset(0, 0)
    glowSpace.Size = UDim2.fromOffset(h, h)
    glowSpace.BackgroundTransparency = 1
    glowSpace.BorderSizePixel = 0
    glowSpace.ZIndex = 1
    glowSpace.Parent = centerContainer

    local function targetGlow(d)
        return cfg.GlowStrength * (1 - smoothstepCrosshair(d / glowR))
    end

    local layerTransp = table.create(n, 1)
    local layerPerp = table.create(n, 0)
    local layerExtra = table.create(n, 0)
    for j = 1, n do
        local tj = targetGlow(glowR * (j - 0.5) / n)
        local tn = (j < n) and targetGlow(glowR * (j + 0.5) / n) or 0
        layerTransp[j] = (1 - tj) / (1 - tn)
        local k = glowR * j / n
        layerPerp[j] = (perpBase + 2 * k) / h
        layerExtra[j] = 2 * k
    end

    local directions = {Vector2.new(0, -1), Vector2.new(0, 1), Vector2.new(-1, 0), Vector2.new(1, 0)}
    local components = {}

    for i, dir in ipairs(directions) do
        local isHoriz = dir.X ~= 0
        local outline = Instance.new("Frame")
        outline.Name = string.format("Borde_%d", i)
        outline.BorderSizePixel = 0
        outline.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        outline.BackgroundTransparency = 0.5
        outline.AnchorPoint = Vector2.new(0.5, 0.5)
        outline.ZIndex = 10
        outline.Parent = centerContainer

        local line = Instance.new("Frame")
        line.Name = string.format("Linea_%d", i)
        line.BorderSizePixel = 0
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.ZIndex = 11
        line.Parent = centerContainer

        local lineStroke = Instance.new("UIStroke")
        lineStroke.Name = "ContornoNegro"
        lineStroke.Thickness = cfg.LineOutlineThick
        lineStroke.Color = Color3.fromRGB(0, 0, 0)
        lineStroke.Transparency = 0
        lineStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        lineStroke.LineJoinMode = Enum.LineJoinMode.Miter
        lineStroke.Parent = line

        local layers = table.create(n)
        for j = 1, n do
            local k = glowR * j / n
            local glow = Instance.new("Frame")
            glow.Name = string.format("GlowLayer_%d_%d", i, j)
            glow.BorderSizePixel = 0
            glow.AnchorPoint = Vector2.new(isHoriz and (0.5 - dir.X * 0.5) or 0.5, isHoriz and 0.5 or (0.5 - dir.Y * 0.5))
            glow.Position = UDim2.fromScale(0.5 + dir.X * (cfg.Gap - k) / h, 0.5 + dir.Y * (cfg.Gap - k) / h)
            glow.BackgroundTransparency = layerTransp[j]
            glow.ZIndex = n - j + 1
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0.5, 0)
            corner.Parent = glow
            glow.Parent = glowSpace
            table.insert(layers, glow)
        end
        table.insert(components, {Line = line, Outline = outline, Glows = layers, Dir = dir, IsHorizontal = isHoriz})
    end

    local wmLabel = Instance.new("TextLabel")
    wmLabel.Name = "YokaiWatermark"
    wmLabel.Text = cfg.WatermarkText
    wmLabel.Font = Enum.Font.Code
    wmLabel.TextSize = 13
    wmLabel.Size = UDim2.fromOffset(100, 20)
    wmLabel.AnchorPoint = Vector2.new(0.5, 0)
    wmLabel.BackgroundTransparency = 1
    wmLabel.ZIndex = 12

    local textStroke = Instance.new("UIStroke")
    textStroke.Thickness = 1
    textStroke.Color = Color3.fromRGB(0, 0, 0)
    textStroke.Transparency = 0.4
    textStroke.Parent = wmLabel

    wmLabel.Parent = screenGui

    local tgN = cfg.TextGlowLayers
    local tgR = cfg.TextGlowRadius

    local function textTarget(d)
        return cfg.TextGlowStrength * (1 - smoothstepCrosshair(d / tgR))
    end

    local textGlows = {}
    for j = 1, tgN do
        local tj = textTarget(tgR * (j - 0.5) / tgN)
        local tn = (j < tgN) and textTarget(tgR * (j + 0.5) / tgN) or 0
        local k = tgR * j / tgN

        local glowText = Instance.new("TextLabel")
        glowText.Name = string.format("TextGlowLayer_%d", j)
        glowText.Text = cfg.WatermarkText
        glowText.Font = wmLabel.Font
        glowText.TextSize = wmLabel.TextSize
        glowText.Size = wmLabel.Size
        glowText.AnchorPoint = wmLabel.AnchorPoint
        glowText.BackgroundTransparency = 1
        glowText.TextTransparency = 1
        glowText.ZIndex = 12 - j

        local glowStroke = Instance.new("UIStroke")
        glowStroke.Thickness = k * 2
        glowStroke.Transparency = (1 - tj) / (1 - tn)
        glowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
        glowStroke.LineJoinMode = Enum.LineJoinMode.Round
        glowStroke.Parent = glowText

        glowText.Parent = screenGui
        table.insert(textGlows, {Label = glowText, Stroke = glowStroke})
    end

    local tickCounter, menuMode, smoothPos, smoothRot = 0, false, Vector2.new(0, 0), 0

    Visuals.Connections.CrosshairInput = UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.M or input.KeyCode == Enum.KeyCode.ButtonSelect then
            menuMode = not menuMode
        end
    end)

    Visuals.Connections.CrosshairRender = RunService.PreRender:Connect(function(dt)
        if not Visuals.CrosshairEnabled or not centerContainer or not centerContainer.Parent then
            return
        end
        tickCounter += dt

        local targetPos = not menuMode
            and (screenGui.AbsoluteSize * 0.5)
            or (GuiService.SelectedObject and (GuiService.SelectedObject.AbsolutePosition + (GuiService.SelectedObject.AbsoluteSize * 0.5)) or UserInputService:GetMouseLocation())
        smoothPos = smoothPos:Lerp(targetPos, 1 - math.exp(-25 * dt))
        centerContainer.Position = UDim2.fromOffset(smoothPos.X, smoothPos.Y)

        local pulse = math.sin(tickCounter * cfg.PulseSpd)
        local dynamicLength = cfg.Length + (pulse * cfg.SizeRng)
        smoothRot = (smoothRot + (cfg.RotSpd * (0.35 + ((pulse + 1) * 0.5 * (1.75 - 0.35)))) * dt) % 360
        centerContainer.Rotation = smoothRot

        local currentColor = Color3.fromHSV((tickCounter * cfg.RGBSpeed) % 1, 1, 1)

        for _, comp in ipairs(components) do
            local centerOffset = cfg.Gap + (dynamicLength * 0.5)
            local posX, posY = comp.Dir.X * centerOffset, comp.Dir.Y * centerOffset
            local sizeW, sizeH = comp.IsHorizontal and dynamicLength or cfg.Thick, comp.IsHorizontal and cfg.Thick or dynamicLength

            comp.Line.Size = UDim2.fromOffset(sizeW, sizeH)
            comp.Line.Position = UDim2.fromOffset(posX, posY)
            comp.Line.BackgroundColor3 = currentColor
            comp.Outline.Size = UDim2.fromOffset(sizeW + (comp.IsHorizontal and 0 or 2), sizeH + (comp.IsHorizontal and 2 or 0))
            comp.Outline.Position = UDim2.fromOffset(posX, posY)
            comp.Line.BackgroundColor3 = cfg.LineColor

            for j, glow in ipairs(comp.Glows) do
                local along = (dynamicLength + layerExtra[j]) / h
                glow.Size = comp.IsHorizontal and UDim2.fromScale(along, layerPerp[j]) or UDim2.fromScale(layerPerp[j], along)
                glow.BackgroundColor3 = currentColor
                glow.BackgroundColor3 = cfg.LineColor
            end
        end

        wmLabel.Text = cfg.WatermarkText

        local maxLineLength = cfg.Length + cfg.SizeRng
        local fixedBottomOffset = cfg.Gap + maxLineLength

        wmLabel.Position = UDim2.fromOffset(smoothPos.X, smoothPos.Y + fixedBottomOffset + 0)
        wmLabel.TextColor3 = currentColor
        wmLabel.TextColor3 = cfg.TextColor

        for _, tg in ipairs(textGlows) do
            tg.Label.Text = cfg.WatermarkText
            tg.Label.Position = wmLabel.Position
            tg.Stroke.Color = currentColor
            tg.Stroke.Color = cfg.TextColor
        end
    end)
end

