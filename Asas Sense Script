local Aim = {}
Aim.AssistEnabled = false; Aim.AssistStrength = 0.3; Aim.AssistFOV = 150
Aim.SilentEnabled = false; Aim.SilentFOV = 100; Aim.SilentChance = 100
Aim.TriggerEnabled = false; Aim.TriggerDelay = 0.1
Aim._assistConn = nil; Aim._silentConn = nil; Aim._triggerConn = nil; Aim._triggerTask = nil
local function getClosestTarget(fov)
    local closest = nil; local shortestDist = fov
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not isTeamExcluded(plr) and not Whitelist.Has(plr) then
            local char = plr.Character
            if char then
                local head = char:FindFirstChild("Head"); local hum = char:FindFirstChildOfClass("Humanoid")
                if head and hum and hum.Health > 0 then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < shortestDist then shortestDist = dist; closest = head end
                    end
                end
            end
        end
    end
    return closest
end
function Aim.SetAssist(state)
    if Aim.AssistEnabled == state then return end
    Aim.AssistEnabled = state
    if state then
        Aim._assistConn = RunService.RenderStepped:Connect(function()
            if not Aim.AssistEnabled then return end
            local target = getClosestTarget(Aim.AssistFOV)
            if target then Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), Aim.AssistStrength) end
        end)
    else if Aim._assistConn then Aim._assistConn:Disconnect(); Aim._assistConn = nil end end
end
function Aim.SetSilent(state)
    if Aim.SilentEnabled == state then return end
    Aim.SilentEnabled = state
    if state then
        Aim._silentConn = RunService.RenderStepped:Connect(function()
            if not Aim.SilentEnabled then return end
            local target = getClosestTarget(Aim.SilentFOV)
            if target and math.random(1, 100) <= Aim.SilentChance then
                local oldCF = Camera.CFrame; Camera.CFrame = CFrame.new(oldCF.Position, target.Position); task.wait(); Camera.CFrame = oldCF
            end
        end)
    else if Aim._silentConn then Aim._silentConn:Disconnect(); Aim._silentConn = nil end end
end
function Aim.SetTrigger(state)
    if Aim.TriggerEnabled == state then return end
    Aim.TriggerEnabled = state
    if state then
        Aim._triggerConn = RunService.RenderStepped:Connect(function()
            if not Aim.TriggerEnabled then return end
            local target = getClosestTarget(Aim.SilentFOV)
            if target and not Aim._triggerTask then
                Aim._triggerTask = task.delay(Aim.TriggerDelay, function()
                    if Aim.TriggerEnabled and target then
                        local vu = game:GetService("VirtualUser"); vu:ClickButton1(Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2))
                    end
                    Aim._triggerTask = nil
                end)
            end
        end)
    else
